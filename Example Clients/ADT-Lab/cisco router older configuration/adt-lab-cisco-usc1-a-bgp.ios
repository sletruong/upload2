configure terminal
!
! ─── BGP Configuration: adt-lab-cisco-usc1-a (us-central1-a) ───────────────────
! Cisco ASN : 65100
! Router-ID : 172.16.1.3  (Gi4, lan-transit, unique per instance)
!
! Interface  | Cisco IP     | Cloud Router IPs       | CR ASN
! Gi2 (WAN1) | 10.0.1.4     | 10.0.1.5 / 10.0.1.6   | 65035
! Gi3 (WAN2) | 10.0.11.4    | 10.0.11.5 / 10.0.11.6  | 65037
! Gi4 (LAN)  | 172.16.1.3   | 172.16.1.5 / 172.16.1.6 | 65033
!

router bgp 65100
 bgp router-id 172.16.1.3
 bgp log-neighbor-changes
 !
 ! WAN1 — Cloud Router ASN 65035, NCC interfaces 10.0.1.5 / 10.0.1.6
 neighbor 10.0.1.5 remote-as 65035
 neighbor 10.0.1.5 description CR-wan1-usc1-nic0
 neighbor 10.0.1.5 ebgp-multihop 2
 neighbor 10.0.1.6 remote-as 65035
 neighbor 10.0.1.6 description CR-wan1-usc1-nic1
 neighbor 10.0.1.6 ebgp-multihop 2
 !
 ! WAN2 — Cloud Router ASN 65037, NCC interfaces 10.0.11.5 / 10.0.11.6
 neighbor 10.0.11.5 remote-as 65037
 neighbor 10.0.11.5 description CR-wan2-usc1-nic0
 neighbor 10.0.11.5 ebgp-multihop 2
 neighbor 10.0.11.6 remote-as 65037
 neighbor 10.0.11.6 description CR-wan2-usc1-nic1
 neighbor 10.0.11.6 ebgp-multihop 2
 !
 ! LAN-TRANSIT — Cloud Router ASN 65033, NCC interfaces 172.16.1.5 / 172.16.1.6
 neighbor 172.16.1.5 remote-as 65033
 neighbor 172.16.1.5 description CR-lan-usc1-nic0
 neighbor 172.16.1.5 ebgp-multihop 2
 neighbor 172.16.1.6 remote-as 65033
 neighbor 172.16.1.6 description CR-lan-usc1-nic1
 neighbor 172.16.1.6 ebgp-multihop 2
 !
 address-family ipv4
  neighbor 10.0.1.5 activate
  neighbor 10.0.1.6 activate
  neighbor 10.0.11.5 activate
  neighbor 10.0.11.6 activate
  neighbor 172.16.1.5 activate
  neighbor 172.16.1.6 activate
 exit-address-family
exit
!
end
write memory
